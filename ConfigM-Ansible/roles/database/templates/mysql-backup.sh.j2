#!/bin/bash
#
# MySQL Database Backup Script
# Generated by Ansible
#

set -e

# Configuration
BACKUP_DIR="{{ mysql_backup_dir }}"
DB_NAME="{{ database_name }}"
DB_USER="root"
DB_PASS="{{ mysql_root_password }}"
RETENTION_DAYS="{{ backup_retention_days }}"
DATE=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="${BACKUP_DIR}/${DB_NAME}_${DATE}.sql.gz"
LOG_FILE="${BACKUP_DIR}/backup.log"

# Create backup directory if it doesn't exist
mkdir -p "${BACKUP_DIR}"

# Function to log messages
log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "${LOG_FILE}"
}

# Function to cleanup old backups
cleanup_old_backups() {
    log_message "Cleaning up backups older than ${RETENTION_DAYS} days"
    find "${BACKUP_DIR}" -name "${DB_NAME}_*.sql.gz" -type f -mtime +${RETENTION_DAYS} -delete
    log_message "Cleanup completed"
}

# Function to perform backup
perform_backup() {
    log_message "Starting backup of database: ${DB_NAME}"
    
    if mysqldump -u "${DB_USER}" -p"${DB_PASS}" \
        --single-transaction \
        --routines \
        --triggers \
        --events \
        --hex-blob \
        --opt \
        "${DB_NAME}" | gzip > "${BACKUP_FILE}"; then
        
        log_message "Backup completed successfully: ${BACKUP_FILE}"
        
        # Get backup file size
        BACKUP_SIZE=$(du -h "${BACKUP_FILE}" | cut -f1)
        log_message "Backup file size: ${BACKUP_SIZE}"
        
        return 0
    else
        log_message "ERROR: Backup failed for database: ${DB_NAME}"
        return 1
    fi
}

# Function to verify backup
verify_backup() {
    if [ -f "${BACKUP_FILE}" ] && [ -s "${BACKUP_FILE}" ]; then
        log_message "Backup file verification: PASSED"
        return 0
    else
        log_message "ERROR: Backup file verification: FAILED"
        return 1
    fi
}

# Main execution
log_message "=== MySQL Backup Script Started ==="

if ! command -v mysqldump &> /dev/null; then
    log_message "ERROR: mysqldump command not found"
    exit 1
fi

# Test database connection
if ! mysql -u "${DB_USER}" -p"${DB_PASS}" -e "SELECT 1;" &> /dev/null; then
    log_message "ERROR: Cannot connect to MySQL database"
    exit 1
fi

# Perform backup
if perform_backup && verify_backup; then
    cleanup_old_backups
    log_message "=== MySQL Backup Script Completed Successfully ==="
    exit 0
else
    log_message "=== MySQL Backup Script Failed ==="
    exit 1
fi
